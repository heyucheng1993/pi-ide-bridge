{
	"name": "pi-ide-bridge",
	"version": "0.4.4",
	"description": "IDE bridge extension for Pi: VS Code / Cursor / Trae context, file inserts, and heartbeat support.",
	"main": "extensions/ide-bridge.ts",
	"scripts": {
		"test": "node test/attachments.cjs",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"ide-bridge",
		"vscode",
		"cursor",
		"trae"
	],
	"author": "Wuhu-dsm",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Wuhu-dsm/pi-ide-bridge.git"
	},
	"bugs": {
		"url": "https://github.com/Wuhu-dsm/pi-ide-bridge/issues"
	},
	"homepage": "https://github.com/Wuhu-dsm/pi-ide-bridge#readme",
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/ide-bridge.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.5.2",
		"@earendil-works/pi-tui": ">=1.5.2"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.2",
		"@earendil-works/pi-tui": "^1.5.2",
		"@types/node": "^22.19.19",
		"jiti": "^2.7.0",
		"typescript": "^5.9.3"
	}
}
